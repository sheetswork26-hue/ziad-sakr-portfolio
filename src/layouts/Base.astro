---
import '../styles/global.css';
import { site } from '../site';
import Logo from '../components/Logo.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { t, home, type Lang } from '../i18n';

interface Props { title?: string; description?: string; lang?: Lang; }
const { title, lang = 'en' } = Astro.props;
const T = t(lang);
const description = Astro.props.description ?? T.meta.description;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${T.meta.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Home has an Arabic twin; project pages are English-only (switcher sends them to the Arabic home).
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/ar/' || Astro.url.pathname === '/ar';
const otherLang: Lang = lang === 'ar' ? 'en' : 'ar';
---
<!doctype html>
<html lang={lang} dir={T.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og.jpg", Astro.site)} />
    <meta name="theme-color" content="#0e0b16" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    {lang === 'ar' && <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />}
    {isHome && (
      <>
        <link rel="alternate" hreflang="en" href={new URL('/', Astro.site)} />
        <link rel="alternate" hreflang="ar" href={new URL('/ar/', Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a href={home(lang)} class="brand">
          <Logo size={30} />
          <span>{site.name}</span>
        </a>
        <div class="nav-right">
          <nav class="nav-links" aria-label={T.nav.sections}>
            <a href={home(lang, '#work')} data-spy="work">{T.nav.work}</a>
            <a href={home(lang, '#services')} data-spy="services">{T.nav.services}</a>
            <a href={home(lang, '#process')} data-spy="process">{T.nav.process}</a>
          </nav>
          <LangSwitch lang={lang} href={isHome ? home(otherLang) : home(otherLang)} />
          <a href={home(lang, '#contact')} class="btn btn-primary nav-cta" data-spy="contact">{T.nav.book}</a>
        </div>
      </div>
      <!-- phones: scrollable section chips with the same highlight -->
      <nav class="subnav" aria-label={T.nav.sections}>
        <a href={home(lang, '#work')} data-spy="work">{T.nav.work}</a>
        <a href={home(lang, '#services')} data-spy="services">{T.nav.services}</a>
        <a href={home(lang, '#process')} data-spy="process">{T.nav.process}</a>
        <a href={home(lang, '#contact')} data-spy="contact">{T.nav.contact}</a>
      </nav>
    </header>

    <script>
      // Auto-hide header (CSS applies it on phones only): hide on scroll down, show on scroll up.
      const nav = document.querySelector<HTMLElement>('header.nav');
      if (nav) {
        let lastY = scrollY, ticking = false;
        const update = () => {
          const y = scrollY, dy = y - lastY;
          if (y < nav.offsetHeight) nav.classList.remove('nav-hide');          // near the top: always visible
          else if (dy > 6) nav.classList.add('nav-hide');                      // scrolling down
          else if (dy < -6) nav.classList.remove('nav-hide');                  // scrolling up
          if (Math.abs(dy) > 6) lastY = y;
          ticking = false;
        };
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        nav.addEventListener('focusin', () => nav.classList.remove('nav-hide')); // keyboard users
      }

      // Scroll-spy: highlight the menu item of the section currently on screen.
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
      const sections = [...new Set(links.map((a) => a.dataset.spy!))]
        .map((id) => document.getElementById(id))
        .filter((s): s is HTMLElement => !!s);
      const sub = document.querySelector<HTMLElement>('.subnav');
      let current = '';
      const setActive = (id: string) => {
        if (id === current) return;
        current = id;
        links.forEach((a) => {
          const on = a.dataset.spy === id;
          a.classList.toggle('active', on);
          if (on) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
          if (on && sub && sub.contains(a)) {
            // keep the active chip visible (works for both LTR and RTL)
            const sr = sub.getBoundingClientRect(), ar = a.getBoundingClientRect();
            sub.scrollBy({ left: ar.left - sr.left - (sr.width - ar.width) / 2, behavior: 'smooth' });
          }
        });
      };
      const onScroll = () => {
        const line = innerHeight * 0.35;
        let id = '';
        for (const s of sections) {
          const r = s.getBoundingClientRect();
          if (r.top <= line && r.bottom > line) id = s.id;
        }
        if (sections.length && innerHeight + scrollY >= document.documentElement.scrollHeight - 4) id = sections[sections.length - 1].id;
        setActive(id);
      };
      if (sections.length) {
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll);
        onScroll();
      }
    </script>

    <main><slot /></main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <div>
          <a href={home(lang)} class="brand"><Logo size={30} /><span>{site.name}</span></a>
          <p class="muted">{T.meta.role}</p>
        </div>
        <div class="footer-links mono">
          <a href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={site.links.github} target="_blank" rel="noopener">GitHub</a>
          <a href={site.links.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
      <div class="wrap footer-base mono">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span class="status"><i></i> {T.footer.status}</span>
      </div>
    </footer>

    <a class="wa-fab" href={site.links.whatsapp} target="_blank" rel="noopener" aria-label={`${T.footer.chat} ${site.whatsapp}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
    </a>
  </body>
</html>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--line);
  }
  /* phones: header hides while scrolling down, comes back on scroll up */
  @media (max-width: 720px) {
    .nav { transition: transform .32s cubic-bezier(.16, 1, .3, 1); will-change: transform; }
    .nav.nav-hide { transform: translateY(-100%); }
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; letter-spacing: -0.01em; }
  .nav-links { display: flex; align-items: center; gap: 28px; font-size: 15px; color: var(--muted); }
  .nav-links a:not(.btn) { position: relative; padding: 6px 2px; transition: color .2s ease; }
  .nav-links a:not(.btn):hover { color: var(--text); }
  .nav-links a:not(.btn)::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; border-radius: 2px;
    background: var(--accent); transform: scaleX(0); transition: transform .25s ease;
  }
  .nav-links a.active:not(.btn) { color: var(--text); }
  .nav-links a.active:not(.btn)::after { transform: scaleX(1); }
  .nav-cta { padding: 9px 16px; font-size: 14.5px; }
  .nav-cta.active { box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent); }
  .nav-right { display: flex; align-items: center; gap: 22px; }
  @media (max-width: 720px) {
    .nav-links { display: none; }
    .nav-right { gap: 10px; }
    .nav-cta { padding: 8px 12px; font-size: 13.5px; }
  }
  @media (max-width: 380px) { .brand span { font-size: 15px; } .nav-cta { padding: 8px 10px; font-size: 13px; } }

  .subnav { display: none; }
  @media (max-width: 720px) {
    .subnav {
      display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none;
      padding: 8px 16px 10px; border-top: 1px solid var(--line);
    }
    .subnav::-webkit-scrollbar { display: none; }
    .subnav a {
      flex-shrink: 0; padding: 6px 14px; border-radius: 999px; font-size: 13.5px;
      color: var(--muted); border: 1px solid var(--line-2); transition: all .2s ease;
    }
    .subnav a.active { background: var(--accent-strong); border-color: var(--accent-strong); color: var(--accent-ink); font-weight: 600; }
  }
  :global(section[id]) { scroll-margin-top: 84px; }
  @media (max-width: 720px) { :global(section[id]) { scroll-margin-top: 128px; } }

  .footer { border-top: 1px solid var(--line); padding: 56px 0 28px; background: var(--bg-2); }
  .footer-inner { display: flex; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .muted { color: var(--muted); margin-top: 8px; font-size: 15px; }
  .footer-links { display: flex; gap: 24px; flex-wrap: wrap; font-size: 14px; color: var(--muted); }
  .footer-links a:hover { color: var(--text); }
  .footer-base { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 12.5px; color: var(--faint); }
  .status { display: inline-flex; align-items: center; gap: 8px; }
  .status i { width: 7px; height: 7px; border-radius: 50%; background: var(--k-action); box-shadow: 0 0 10px var(--k-action); animation: pulse 2s infinite; }
  @keyframes pulse { 50% { opacity: .4; } }

  .wa-fab {
    position: fixed; right: 18px; bottom: 18px; z-index: 90;
    width: 54px; height: 54px; border-radius: 50%;
    display: grid; place-items: center;
    background: #25d366; color: #fff;
    box-shadow: 0 12px 28px -8px rgba(37, 211, 102, .55), 0 2px 6px rgba(0,0,0,.4);
    transition: transform .2s ease;
  }
  .wa-fab:hover { transform: scale(1.06); }
  .wa-fab svg { width: 28px; height: 28px; fill: currentColor; }
  @media (max-width: 640px) { .wa-fab { right: 14px; bottom: 14px; width: 50px; height: 50px; } }
</style>
