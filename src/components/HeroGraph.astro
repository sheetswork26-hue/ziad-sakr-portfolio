---
// Decorative animated workflow graph for the hero.
const nodes = [
  { x: 20,  y: 150, w: 128, label: 'Webhook',     sub: 'new lead',       k: 'trigger' },
  { x: 210, y: 60,  w: 136, label: 'AI Agent',    sub: 'qualify + enrich', k: 'ai' },
  { x: 210, y: 240, w: 136, label: 'Postgres',    sub: 'dedupe',         k: 'data' },
  { x: 410, y: 150, w: 112, label: 'IF',          sub: 'score > 70',     k: 'logic' },
  { x: 580, y: 70,  w: 120, label: 'HubSpot',     sub: 'create deal',    k: 'action' },
  { x: 580, y: 230, w: 120, label: 'Slack',       sub: 'notify sales',   k: 'action' },
];
const H = 58;
const out = (n: typeof nodes[0]) => [n.x + n.w, n.y + H / 2];
const inn = (n: typeof nodes[0]) => [n.x, n.y + H / 2];
const curve = (a: number[], b: number[]) => {
  const dx = (b[0] - a[0]) / 2;
  return `M${a[0]},${a[1]} C${a[0] + dx},${a[1]} ${b[0] - dx},${b[1]} ${b[0]},${b[1]}`;
};
const edges = [[0,1],[0,2],[1,3],[2,3],[3,4],[3,5]].map(([a,b]) => curve(out(nodes[a]), inn(nodes[b])));
---
<div class="graph" aria-hidden="true">
  <svg viewBox="0 0 720 330" fill="none">
    {edges.map((d, i) => (
      <g>
        <path d={d} class="edge" />
        <path d={d} class="pulse" style={`animation-delay:${i * 0.35}s`} />
      </g>
    ))}
    {nodes.map((n, i) => (
      <g class={`node k-${n.k}`} transform={`translate(${n.x},${n.y})`} style={`animation-delay:${i * 0.12}s`}>
        <rect width={n.w} height={H} rx="11" class="box" />
        <rect x="10" y="17" width="24" height="24" rx="7" class="chip" />
        <text x="44" y="26" class="t1">{n.label}</text>
        <text x="44" y="43" class="t2">{n.sub}</text>
        <circle cx="0" cy={H/2} r="4" class="port" />
        <circle cx={n.w} cy={H/2} r="4" class="port" />
      </g>
    ))}
  </svg>
</div>

<style>
  .graph { width: 100%; }
  svg { width: 100%; height: auto; overflow: visible; }
  .edge { stroke: var(--line-2); stroke-width: 1.6; }
  .pulse {
    stroke: var(--accent); stroke-width: 2.2; stroke-linecap: round;
    stroke-dasharray: 18 400; stroke-dashoffset: 418;
    animation: flow 2.8s linear infinite;
    filter: drop-shadow(0 0 4px var(--accent));
  }
  @keyframes flow { to { stroke-dashoffset: 0; } }
  .node { opacity: 0; animation: pop .5s ease forwards; }
  @keyframes pop { from { opacity: 0; transform-box: fill-box; } to { opacity: 1; } }
  .box { fill: var(--surface); stroke: var(--line-2); }
  .chip { fill: color-mix(in srgb, var(--k) 22%, transparent); stroke: var(--k); stroke-width: 1.2; }
  .port { fill: var(--bg); stroke: var(--line-2); stroke-width: 1.5; }
  .t1 { fill: var(--text); font: 600 13px var(--font); }
  .t2 { fill: var(--faint); font: 400 10.5px var(--mono); }
</style>
