---
// ~10s illustrated opening: the SAME employee before automation (drowning in work)
// → a workflow switches on and sweeps the mess away → after automation (relaxed, work runs itself).
// Plays ONCE per visit (browser tab). Not replayed when coming back to Home, refreshing,
// or opening a section link like /#work. Force it with /?intro. Skip / Esc available.
// Dispatches `scene:done` so the hero starts.
---
<script is:inline>
  (function () {
    try {
      var q = new URLSearchParams(location.search);
      var seen = sessionStorage.getItem('zs-intro-seen') === '1';
      if (q.has('intro')) seen = false;          // /?intro → always play
      else if (location.hash) seen = true;       // /#work, /#contact → go straight to the section
      if (seen) document.documentElement.classList.add('intro-seen');
    } catch (e) {}
  })();
</script>
<div class="story" data-scene role="img" aria-label="Animation: before automation an employee is overwhelmed with manual tasks; after automation the same work runs by itself and he relaxes.">
  <div class="st-grid" aria-hidden="true"></div>

  <div class="st-wrap" aria-hidden="true">
    <div class="st-head">
      <span class="tag bad mono">Before automation</span>
      <span class="tag good mono">After automation</span>
    </div>

    <p class="st-line">
      <span class="lb">Hours of copy, paste &amp; chasing messages — every single day.</span>
      <span class="la">The same work. Done automatically, in seconds.</span>
    </p>

    <svg class="art" viewBox="0 0 420 290" fill="none">
      <!-- ===== workflow that appears at the switch ===== -->
      <g class="flow">
        <path class="fl-line" d="M133 34 H163 M255 34 H285" pathLength="1" />
        <path class="fl-pulse a" d="M133 34 H163" pathLength="1" />
        <path class="fl-pulse b" d="M255 34 H285" pathLength="1" />
        <g class="fl-node n1"><rect x="73" y="22" width="60" height="24" rx="7" /><circle cx="86" cy="34" r="4" class="d-trig" /><text x="94" y="37">Trigger</text></g>
        <g class="fl-node n2"><rect x="163" y="22" width="92" height="24" rx="7" /><circle cx="176" cy="34" r="4" class="d-ai" /><text x="184" y="37">AI Automation</text></g>
        <g class="fl-node n3"><rect x="285" y="22" width="62" height="24" rx="7" /><circle cx="298" cy="34" r="4" class="d-act" /><text x="306" y="37">Done ✓</text></g>
      </g>

      <!-- ===== clock (before only) ===== -->
      <g class="clock bf">
        <circle cx="40" cy="36" r="17" class="ck-face" />
        <line x1="40" y1="36" x2="40" y2="26" class="ck-h hr" />
        <line x1="40" y1="36" x2="49" y2="36" class="ck-h mn" />
        <circle cx="40" cy="36" r="2" class="ck-dot" />
      </g>

      <!-- ===== floor, desk, chair ===== -->
      <line x1="16" y1="262" x2="404" y2="262" class="floor" />
      <rect x="54" y="160" width="8" height="64" rx="3" class="chair" />
      <rect x="54" y="206" width="52" height="8" rx="3" class="chair" />
      <line x1="80" y1="214" x2="80" y2="250" class="chair-l" />
      <line x1="66" y1="258" x2="94" y2="258" class="chair-l" />
      <rect x="128" y="186" width="232" height="8" rx="3" class="desk" />
      <rect x="140" y="194" width="6" height="68" class="desk-leg" />
      <rect x="342" y="194" width="6" height="68" class="desk-leg" />

      <!-- ===== laptop ===== -->
      <rect x="196" y="120" width="86" height="60" rx="5" class="lap-screen" />
      <rect x="188" y="180" width="102" height="6" rx="2" class="lap-base" />
      <!-- screen: before = copy/paste between two windows -->
      <g class="scr bf">
        <rect x="203" y="128" width="32" height="24" rx="2" class="win" />
        <line x1="207" y1="135" x2="230" y2="135" class="wl" /><line x1="207" y1="140" x2="226" y2="140" class="wl" /><line x1="207" y1="145" x2="229" y2="145" class="wl" />
        <rect x="243" y="128" width="32" height="24" rx="2" class="win" />
        <line x1="247" y1="135" x2="270" y2="135" class="wl" /><line x1="247" y1="140" x2="262" y2="140" class="wl" />
        <path d="M236 140 h6 m-3 -3 l3 3 l-3 3" class="cp-arrow" />
        <text x="239" y="170" class="scr-t bad-t" text-anchor="middle">copy → paste ×127</text>
      </g>
      <!-- screen: after = mini workflow running -->
      <g class="scr af">
        <line x1="214" y1="142" x2="264" y2="142" class="mini-l" />
        <circle cx="214" cy="142" r="6" class="mini n-a" /><circle cx="239" cy="142" r="6" class="mini n-b" /><circle cx="264" cy="142" r="6" class="mini n-c" />
        <circle cx="214" cy="142" r="2.2" class="mini-p" />
        <text x="239" y="170" class="scr-t good-t" text-anchor="middle">● workflows running</text>
      </g>

      <!-- ===== paper piles (before) ===== -->
      <g class="papers bf">
        {[0,1,2,3,4,5,6].map((i) => <rect x={300 - (i % 2) * 3} y={178 - i * 6} width="36" height="5" rx="1" class="sheet" style={`--i:${i}`} />)}
        <rect x="150" y="176" width="30" height="5" rx="1" class="sheet s2" style="--i:2" transform="rotate(-8 165 178)" />
        <rect x="300" y="256" width="30" height="5" rx="1" class="sheet floor-s" style="--i:4" transform="rotate(10 315 258)" />
        <rect x="250" y="257" width="28" height="5" rx="1" class="sheet floor-s" style="--i:6" transform="rotate(-6 264 259)" />
      </g>

      <!-- ===== the person ===== -->
      <g class="person">
        <!-- legs -->
        <rect x="84" y="200" width="46" height="11" rx="5" class="pants" />
        <rect x="120" y="202" width="10" height="56" rx="4" class="pants" />
        <rect x="116" y="254" width="20" height="6" rx="3" class="shoe" />
        <!-- torso -->
        <g class="upper">
          <rect x="70" y="144" width="38" height="62" rx="14" class="shirt" />
          <path d="M84 146 l5 10 l5 -10" class="collar" />
          <!-- typing arm (before) -->
          <g class="arm-type bf"><path d="M100 160 Q140 172 196 176" class="arm" /></g>
          <!-- mug arm (after) -->
          <g class="arm-mug af">
            <path d="M100 160 Q122 168 112 140" class="arm" />
            <rect x="104" y="124" width="14" height="16" rx="3" class="mug" />
            <path d="M118 128 q6 2 0 8" class="mug-h" />
            <path d="M108 118 q-3 -5 0 -9 M114 118 q3 -5 0 -9" class="steam" />
          </g>
          <!-- head -->
          <g class="head">
            <circle cx="89" cy="122" r="17" class="skin" />
            <path d="M72 120 q2 -18 18 -18 q14 0 16 15 q-6 -8 -18 -7 q-10 1 -16 10Z" class="hair" />
            <circle cx="83" cy="123" r="1.6" class="eye" /><circle cx="95" cy="123" r="1.6" class="eye" />
            <path d="M84 132 q5 -4 10 0" class="mouth sad bf" />
            <path d="M83 130 q6 6 12 0" class="mouth happy af" />
            <path d="M108 112 q3 5 0 8 q-3 -3 0 -8Z" class="sweat bf" />
          </g>
        </g>
      </g>

      <!-- ===== notifications (before) ===== -->
      <g class="note bf n1"><rect x="16" y="62" width="118" height="22" rx="8" /><text x="75" y="76.5" text-anchor="middle">✉ 47 unread emails</text></g>
      <g class="note bf n2"><rect x="148" y="60" width="118" height="22" rx="8" /><text x="207" y="74.5" text-anchor="middle">💬 32 new messages</text></g>
      <g class="note bf n3"><rect x="112" y="94" width="80" height="22" rx="8" /><text x="152" y="108.5" text-anchor="middle">🧾 Invoice??</text></g>

      <!-- ===== checklist (after) ===== -->
      <g class="check af">
        <rect x="128" y="50" width="96" height="66" rx="9" class="ch-card" />
        <text x="138" y="63" class="ch-title">Today</text>
        {['Leads saved', 'Replies sent', 'Invoices', 'Report'].map((t, i) => (
          <g class="ch-row" style={`--i:${i}`}>
            <rect x="138" y={67 + i * 11.5} width="8" height="8" rx="2" class="ch-box" />
            <path d={`M139.5 ${71 + i * 11.5} l2 2 l3.5 -4`} class="ch-tick" />
            <text x="151" y={74 + i * 11.5} class="ch-t">{t}</text>
          </g>
        ))}
      </g>

    </svg>

    <div class="meter mono">
      <span>Tasks done <b data-tasks>3</b>/40</span>
      <span class="sep">·</span>
      <span>Manual work <b data-hours>5h</b>/day</span>
    </div>
  </div>

  <p class="punch" aria-hidden="true">I build the <em>after</em>.</p>

  <div class="prog" aria-hidden="true"><i></i></div>
  <button class="skip mono" type="button">Skip intro <span class="sk-arrow" aria-hidden="true">→</span></button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-scene]').forEach((root) => {
    const tasks = root.querySelector('[data-tasks]')!;
    const hours = root.querySelector('[data-hours]')!;
    let timers: number[] = [];
    let raf = 0;
    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
    const count = (from: number, to: number, ms: number) => {
      cancelAnimationFrame(raf);
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / ms);
        tasks.textContent = String(Math.round(from + (to - from) * p));
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    const unlock = () => (document.documentElement.style.overflow = '');

    const finish = () => {
      timers.forEach(clearTimeout); timers = [];
      if (root.classList.contains('gone')) return;
      unlock();
      root.classList.add('out');
      window.dispatchEvent(new CustomEvent('scene:done'));
      setTimeout(() => root.classList.add('gone'), 700);
    };

    const play = () => {
      timers.forEach(clearTimeout); timers = [];
      cancelAnimationFrame(raf);
      root.className = 'story';
      void root.offsetWidth;
      document.documentElement.style.overflow = 'hidden';
      tasks.textContent = '3'; hours.textContent = '5h';
      root.classList.add('p-before', 'run');
      later(() => count(3, 7, 3800), 300);
      later(() => root.classList.add('p-switch'), 4500);
      later(() => { root.classList.remove('p-before'); root.classList.add('p-after'); count(7, 40, 1300); hours.textContent = '0h'; }, 5400);
      later(() => root.classList.add('p-end'), 9300);
      later(finish, 10600);
    };

    root.querySelector('.skip')!.addEventListener('click', finish);
    addEventListener('keydown', (e) => { if (e.key === 'Escape') finish(); });

    // Once per visit: the inline script above already marked <html class="intro-seen">
    // when the intro was shown earlier in this tab, or the URL targets a section (/#work).
    const seen = document.documentElement.classList.contains('intro-seen');
    if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('gone');
      setTimeout(() => window.dispatchEvent(new CustomEvent('scene:done')), 0);
    } else {
      try { sessionStorage.setItem('zs-intro-seen', '1'); } catch {}
      play();
    }
    (window as any).replayScene = play;
  });
</script>

<style>
  .story {
    --bad: #f87171; --good: #34d399; --skin: #e9b48f; --shirt: #3a4456;
    --ease: cubic-bezier(.7, 0, .2, 1); --ease-out: cubic-bezier(.16, 1, .3, 1);
    position: fixed; inset: 0; z-index: 200; background: var(--bg);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 24px 16px 64px; overflow: hidden;
  }
  .story.out { animation: out .7s var(--ease) forwards; pointer-events: none; }
  .story.gone, :global(html.intro-seen) .story { display: none; }
  .st-grid { position: absolute; inset: 0; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 40px 40px; opacity: .28; mask-image: radial-gradient(ellipse at center, #000 15%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse at center, #000 15%, transparent 70%); }
  .story::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at center, transparent 40%, color-mix(in srgb, var(--bad) 18%, transparent)); opacity: 0; transition: opacity .6s ease; }
  .p-before::after { opacity: 1; }
  .p-switch::after { opacity: 0; }

  .st-wrap { position: relative; width: min(560px, 100%); display: grid; gap: 10px; }

  /* captions */
  .st-head { position: relative; height: 30px; }
  .tag { position: absolute; left: 0; top: 0; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; padding: 6px 12px; border-radius: 999px; transition: opacity .4s ease, transform .4s var(--ease-out); }
  .tag.bad { color: var(--bad); background: color-mix(in srgb, var(--bad) 12%, transparent); border: 1px solid color-mix(in srgb, var(--bad) 35%, transparent); opacity: 0; }
  .tag.good { color: var(--good); background: color-mix(in srgb, var(--good) 12%, transparent); border: 1px solid color-mix(in srgb, var(--good) 35%, transparent); opacity: 0; transform: translateY(8px); }
  .p-before .tag.bad { opacity: 1; }
  .p-switch .tag.bad { opacity: 0; transform: translateY(-8px); }
  .p-after .tag.good { opacity: 1; transform: none; }

  .st-line { position: relative; min-height: 2.6em; font-size: clamp(19px, 4.6vw, 26px); font-weight: 500; letter-spacing: -0.02em; line-height: 1.25; }
  .st-line span { position: absolute; inset: 0; transition: opacity .4s ease, transform .4s var(--ease-out); }
  .lb { opacity: 0; } .la { opacity: 0; transform: translateY(8px); color: #eaf7f0; }
  .p-before .lb { opacity: 1; }
  .p-switch .lb { opacity: 0; transform: translateY(-8px); }
  .p-after .la { opacity: 1; transform: none; }

  .meter { display: flex; flex-wrap: wrap; gap: 6px 10px; font-size: 13px; color: var(--muted); }
  .meter b { color: var(--bad); font-weight: 600; transition: color .3s ease; font-variant-numeric: tabular-nums; }
  .p-after .meter b { color: var(--good); }
  .sep { color: var(--faint); }

  /* ===== art ===== */
  .art { width: 100%; height: auto; overflow: visible; margin: 4px 0 2px; }
  .art text { font-family: var(--mono); }
  .floor { stroke: var(--line-2); stroke-width: 1.5; }
  .chair { fill: #232a35; } .chair-l { stroke: #232a35; stroke-width: 4; stroke-linecap: round; }
  .desk { fill: #2a3240; } .desk-leg { fill: #222935; }
  .lap-screen { fill: #0d1015; stroke: #3a4352; stroke-width: 1.5; }
  .lap-base { fill: #3a4352; }
  .win { fill: #1a1f28; stroke: #3a4352; } .wl { stroke: #4a5466; stroke-width: 1.4; stroke-linecap: round; }
  .cp-arrow { stroke: var(--bad); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .scr-t { font-size: 8px; } .bad-t { fill: var(--bad); } .good-t { fill: var(--good); }
  .mini-l { stroke: #3a4352; stroke-width: 1.5; } .mini { fill: #161b23; stroke-width: 1.5; }
  .n-a { stroke: var(--k-trigger); } .n-b { stroke: var(--k-ai); } .n-c { stroke: var(--good); }
  .mini-p { fill: var(--accent); }
  .sheet { fill: #e8e2d6; stroke: #b9b1a2; stroke-width: .6; }
  .pants { fill: #262d3a; } .shoe { fill: #15181e; }
  .shirt { fill: var(--shirt); } .collar { stroke: #f3f3f3; stroke-width: 2; stroke-linejoin: round; }
  .arm { stroke: var(--shirt); stroke-width: 9; stroke-linecap: round; }
  .skin { fill: var(--skin); } .hair { fill: #17191d; } .eye { fill: #1b1b1b; }
  .mouth { stroke: #6b2f22; stroke-width: 1.8; stroke-linecap: round; }
  .sweat { fill: #8fd3ff; }
  .mug { fill: #f3e6dc; } .mug-h { stroke: #f3e6dc; stroke-width: 2; }
  .steam { stroke: rgba(255,255,255,.5); stroke-width: 1.4; stroke-linecap: round; }
  .clock .ck-face { stroke: var(--bad); stroke-width: 2; fill: #14171d; }
  .ck-h { stroke: var(--text); stroke-width: 2; stroke-linecap: round; transform-origin: 40px 36px; }
  .ck-dot { fill: var(--bad); }
  .note rect { fill: #1f242d; stroke: color-mix(in srgb, var(--bad) 55%, #333); }
  .note text { fill: #f5d0d0; font-size: 9.5px; }
  .ch-card { fill: #151a22; stroke: color-mix(in srgb, var(--good) 45%, #333); }
  .ch-title { fill: var(--muted); font-size: 7.5px; letter-spacing: .1em; text-transform: uppercase; }
  .ch-box { fill: none; stroke: #4a5466; } .ch-t { fill: var(--text); font-size: 8.5px; }
  .ch-tick { stroke: #08130d; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; opacity: 0; }
  .fl-node rect { fill: #161b23; stroke: #3a4352; } .fl-node text { fill: var(--text); font-size: 8.5px; }
  .d-trig { fill: var(--k-trigger); } .d-ai { fill: var(--k-ai); } .d-act { fill: var(--good); }
  .fl-line { stroke: #4a5466; stroke-width: 1.6; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .fl-pulse { stroke: var(--accent); stroke-width: 3; stroke-linecap: round; stroke-dasharray: .25 1.4; stroke-dashoffset: .25; opacity: 0; }

  /* phase visibility */
  .bf, .af, .flow .fl-node, .check { opacity: 0; transition: opacity .35s ease; }
  .bf, .af, .fl-node, .note, .sheet, .check, .person, .upper, .head { transform-box: fill-box; }
  .p-before .bf { opacity: 1; }
  .p-after .af { opacity: 1; }

  /* ===== BEFORE motion ===== */
  .p-before .ck-h.mn { animation: spin .8s linear infinite; }
  .p-before .ck-h.hr { animation: spin 4s linear infinite; }
  .p-before .head { transform-origin: 50% 90%; animation: frantic 1.1s ease-in-out infinite; }
  .p-before .arm-type { animation: type .16s linear infinite alternate; transform-origin: 0% 0%; }
  .p-before .sweat { animation: drip 1.2s ease-in infinite; }
  .p-before .cp-arrow { animation: blink .4s steps(2) infinite; }
  .sheet { opacity: 0; }
  .p-before .sheet { animation: drop .35s var(--ease-out) forwards calc(.3s + var(--i) * .45s); }
  .note { opacity: 0; transform-origin: 50% 100%; }
  .p-before .note.n1 { animation: pop .4s var(--ease-out) both .7s, shake .5s ease-in-out infinite 1.2s; }
  .p-before .note.n2 { animation: pop .4s var(--ease-out) both 1.6s, shake .5s ease-in-out infinite 2.1s; }
  .p-before .note.n3 { animation: pop .4s var(--ease-out) both 2.5s, shake .5s ease-in-out infinite 3s; }

  /* ===== SWITCH: workflow turns on, mess gets sucked into it ===== */
  .p-switch .fl-node { opacity: 1; }
  .p-switch .fl-node.n1 { animation: pop .35s var(--ease-out) both; }
  .p-switch .fl-node.n2 { animation: pop .35s var(--ease-out) both .15s; }
  .p-switch .fl-node.n3 { animation: pop .35s var(--ease-out) both .3s; }
  .p-switch .fl-line { animation: draw .5s var(--ease) forwards .2s; }
  .p-switch .papers .sheet, .p-switch .note { animation: suck .7s var(--ease) forwards !important; }
  .p-switch .note.n2 { animation-delay: .05s !important; } .p-switch .note.n3 { animation-delay: .1s !important; }
  .p-switch .clock { opacity: 0; }

  /* ===== AFTER motion ===== */
  .p-after .fl-pulse.a { animation: pulse 1.1s linear infinite; }
  .p-after .fl-pulse.b { animation: pulse 1.1s linear infinite .55s; }
  .p-after .upper { transform-origin: 30% 95%; animation: lean .8s var(--ease-out) forwards; }
  .p-after .steam { animation: steam 1.6s ease-in-out infinite; }
  .p-after .mini-p { animation: travel 1.4s linear infinite; }
  .p-after .check { opacity: 1; animation: pop .45s var(--ease-out) both .2s; }
  .p-after .ch-row .ch-box { animation: fillBox .3s ease forwards calc(.6s + var(--i) * .35s); }
  .p-after .ch-row .ch-tick { animation: show .2s ease forwards calc(.7s + var(--i) * .35s); }

  /* punchline + progress */
  .punch { position: absolute; left: 0; right: 0; bottom: 18%; text-align: center; font-size: clamp(26px, 6vw, 40px); font-weight: 500; letter-spacing: -0.03em; opacity: 0; transform: translateY(10px); transition: opacity .5s ease, transform .5s var(--ease-out); }
  .punch em { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; color: var(--accent); font-size: 1.12em; }
  .p-end .punch { opacity: 1; transform: none; }
  .p-end .st-wrap { opacity: .15; transition: opacity .5s ease; }
  .prog { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--line); }
  .prog i { display: block; height: 100%; width: 0; background: var(--accent); }
  .run .prog i { animation: grow 10.6s linear forwards; }
  /* Skip: slides up from the bottom, then breathes with a soft pink glow so it gets noticed */
  .skip {
    position: absolute; left: 50%; bottom: 22px; z-index: 5;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 11px 20px; border-radius: 999px; cursor: pointer;
    font-size: 13px; letter-spacing: .02em; color: var(--text);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 60%, transparent);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    opacity: 0; transform: translate(-50%, 28px);
    transition: background .2s ease, color .2s ease, border-color .2s ease;
    overflow: hidden;
  }
  .skip::before {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,.22) 50%, transparent 70%);
    transform: translateX(-120%);
  }
  .sk-arrow { display: inline-block; color: var(--accent); }
  .run .skip { animation: skipIn .6s var(--ease-out) forwards .8s, skipGlow 2.4s ease-in-out infinite 1.5s; }
  .run .skip::before { animation: skipShine 2.4s ease-in-out infinite 1.5s; }
