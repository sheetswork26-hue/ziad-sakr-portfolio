---
// Card for the "Websites" tab: screenshot + live link + code link. English-only like project cards.
interface Props { site: any; index: number; liveLabel: string; codeLabel: string; }
const { site, index, liveLabel, codeLabel } = Astro.props;
const d = site.data;
---
<article class="site" style={`--c:${d.accent}`} dir="ltr" lang="en">
  <a href={d.url} target="_blank" rel="noopener" class="shot" aria-label={`${d.title} — ${liveLabel}`}>
    <img src={d.image} alt={`${d.title} homepage`} width="800" height="500" loading="lazy" decoding="async" />
  </a>
  <div class="body">
    <div class="top">
      <span class="mono idx">{String(index + 1).padStart(2, '0')}</span>
      <span class="mono type">{d.type}</span>
    </div>
    <h3>{d.title}</h3>
    <p class="summary">{d.summary}</p>
    <div class="tags">{d.stack.slice(0, 4).map((s: string) => <span class="tag">{s}</span>)}</div>
    <div class="actions" dir="auto">
      <a class="btn live" href={d.url} target="_blank" rel="noopener">{liveLabel} <span aria-hidden="true">↗</span></a>
      {d.repo && <a class="btn code" href={d.repo} target="_blank" rel="noopener">{codeLabel}</a>}
    </div>
  </div>
</article>

<style>
  .site {
    position: relative; display: flex; flex-direction: column;
    border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line);
    overflow: hidden; transition: border-color .2s ease, transform .2s ease;
  }
  .site:hover { border-color: var(--line-2); transform: translateY(-3px); }
  .shot { display: block; aspect-ratio: 16 / 10; overflow: hidden; border-bottom: 1px solid var(--line); background: var(--surface-2); }
  .shot img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  .site:hover .shot img { transform: scale(1.03); }
  .body { display: flex; flex-direction: column; gap: 14px; padding: 22px 24px 24px; flex: 1; }
  .top { display: flex; justify-content: space-between; font-size: 12px; color: var(--faint); }
  .type { color: var(--muted); }
  h3 { font-size: 24px; }
  .summary { color: var(--muted); font-size: 15.5px; }
  .actions { display: flex; gap: 10px; margin-top: auto; padding-top: 4px; }
  .btn {
    flex: 1; display: inline-flex; justify-content: center; align-items: center; gap: 6px;
    min-height: 44px; padding: 0 16px; border-radius: 10px; font-size: 14.5px; font-weight: 600;
    border: 1px solid var(--line-2); color: var(--text); transition: border-color .2s ease, background .2s ease;
  }
  .btn.live { background: var(--accent-strong); border-color: var(--accent-strong); color: var(--accent-ink); }
  .btn.live:hover { background: var(--accent-hover); }
  .btn.code:hover { border-color: var(--muted); }
  @media (max-width: 420px) { .body { padding: 18px 18px 20px; } h3 { font-size: 22px; } }
</style>
