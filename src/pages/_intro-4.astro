---
// Attempt 4 (تجربة 4) — Before/After automation scene → Attempt 3 hero. Not linked from the site yet.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BeforeAfterScene from '../components/BeforeAfterScene.astro';
import IntroHero from '../components/IntroHero3.astro';
import { site } from '../site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const runs = projects.map((p) => {
  const flow = p.data.flow;
  const ai = flow.find((s) => s.kind === 'ai') ?? flow[Math.floor(flow.length / 2)];
  const m = p.data.metrics[0];
  return { slug: p.id, title: p.data.title, trigger: flow[0].label, ai: ai.label, result: flow[flow.length - 1].label, metric: `${m.value} · ${m.label}` };
});
---
<Base title="Intro — Attempt 4">
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  <BeforeAfterScene />
  <IntroHero name={site.name} photo="/me.webp" stats={site.stats} runs={runs} />
  <button class="replay mono" onclick="window.replayScene && window.replayScene()">↻ replay intro</button>
</Base>

<style>
  .replay { position: fixed; left: 18px; bottom: 18px; z-index: 100; padding: 9px 14px; border-radius: 999px; cursor: pointer; background: var(--surface); color: var(--muted); border: 1px solid var(--line-2); font-size: 12px; }
  .replay:hover { color: var(--text); border-color: var(--muted); }
</style>
