---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AutomationStory from '../components/AutomationStory.astro';
import IntroHero from '../components/IntroHero3.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const runs = projects.map((p) => {
  const flow = p.data.flow;
  const ai = flow.find((s) => s.kind === 'ai') ?? flow[Math.floor(flow.length / 2)];
  const m = p.data.metrics[0];
  return { slug: p.id, title: p.data.title, trigger: flow[0].label, ai: ai.label, result: flow[flow.length - 1].label, metric: `${m.value} · ${m.label}` };
});

const services = [
  { k: 'ai', title: 'AI Agents & Chatbots', body: 'Support, sales and internal agents on WhatsApp, Telegram, Slack or your site — grounded in your data with RAG, tools and human hand-off.', items: ['OpenAI · Claude · Gemini', 'Vector stores & RAG', 'Memory + tool calling'] },
  { k: 'action', title: 'Business Process Automation', body: 'Lead routing, onboarding, invoicing, reporting — the repetitive work your team does every day, turned into reliable workflows.', items: ['CRM & marketing ops', 'Finance & back-office', 'Scheduled reporting'] },
  { k: 'data', title: 'Integrations & Data Pipelines', body: 'Connect the tools that don\'t talk to each other. Custom APIs, webhooks, syncing and data cleaning between any systems.', items: ['REST / GraphQL / webhooks', 'Postgres · Sheets · Airtable', 'Self-hosted n8n setup'] },
];

const process = [
  { n: '01', title: 'Discovery call', body: 'We map the process, the tools and the cost of doing it manually.' },
  { n: '02', title: 'Blueprint', body: 'A clear workflow diagram, timeline and fixed price — before any build.' },
  { n: '03', title: 'Build & test', body: 'Built with error handling, retries, logging and real test data.' },
  { n: '04', title: 'Handover', body: 'Documentation, a Loom walkthrough and 30 days of support.' },
];
---
<Base>
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />

  <!-- INTRO: ~10s before/after automation animation (every visit, skippable) → hero with photo + live runs -->
  <AutomationStory />
  <IntroHero name={site.name} photo="/me.webp" stats={site.stats} runs={runs} />

  <!-- WORK -->
  <section id="work" class="work">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Selected work</span>
          <h2>Systems I've designed &amp; built</h2>
        </div>
        <p>Each project solves a real business problem — with the actual workflow, the stack and the engineering decisions behind it.</p>
      </div>
      <div class="cards">
        {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="services">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Services</span>
          <h2>What I can build for you</h2>
        </div>
      </div>
      <div class="svc-grid">
        {services.map((s) => (
          <article class={`svc k-${s.k}`}>
            <span class="svc-icon" aria-hidden="true"></span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <ul class="mono">{s.items.map((it) => <li>{it}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section id="process" class="process">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Process</span>
          <h2>From messy process to shipped workflow</h2>
        </div>
        <p>Fixed scope, fixed price, no surprises. Most projects ship in 1–3 weeks.</p>
      </div>
      <ol class="steps">
        {process.map((p) => (<li><span class="mono n">{p.n}</span><h3>{p.title}</h3><p>{p.body}</p></li>))}
      </ol>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="contact">
    <div class="wrap contact-inner">
      <div>
        <span class="eyebrow">Contact</span>
        <h2>Got a process that eats your team's time?</h2>
        <p class="lede">Tell me about it. I'll reply within 24 hours with how I'd automate it — free.</p>
        <div class="direct">
          <a class="btn wa" href={site.links.whatsapp} target="_blank" rel="noopener">WhatsApp · <span class="mono">{site.whatsapp}</span></a>
          <a class="btn" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        </div>
        <p class="mono note">Prefer the form? Your message goes straight to my inbox — I reply within 24 hours.</p>
      </div>
      <form class="form" data-key={site.web3formsKey} novalidate>
        <label>Name<input name="name" required autocomplete="name" dir="auto" maxlength="80" /></label>
        <label>Email<input name="email" type="email" required autocomplete="email" inputmode="email" maxlength="120" /></label>
        <label>Phone / WhatsApp <span class="opt">(optional)</span>
          <input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+20 10x xxx xxxx" maxlength="20" />
        </label>
        <label>What do you want to automate?<textarea name="message" rows="4" required dir="auto" maxlength="3000"></textarea></label>
        <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn btn-primary" type="submit">Send message <span class="arrow">→</span></button>
        <p class="form-status mono" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('.form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const setStatus = (msg: string, kind: '' | 'ok' | 'err' = '') => { status.textContent = msg; status.dataset.kind = kind; };

    if (data._honey) return; // bot
    const phone = (data.phone || '').trim();
    if (!data.name?.trim()) return setStatus('Please enter your name.', 'err');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(data.email || '')) return setStatus('Please enter a valid email.', 'err');
    if (phone && !/^\+?[\d\s\-()]{7,20}$/.test(phone)) return setStatus('Please enter a valid phone number (digits only, + allowed).', 'err');
    if (!data.message?.trim()) return setStatus('Please tell me what you want to automate.', 'err');

    const key = form.dataset.key;
    if (!key) return setStatus('Form not connected yet — please message me on WhatsApp for now.', 'err');

    btn.disabled = true;
    setStatus('Sending…');
    try {
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 15000);
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        signal: ctrl.signal,
        body: JSON.stringify({
          access_key: key,
          subject: `New portfolio inquiry from ${data.name.trim()}`,
          from_name: 'Ziad Sakr — Portfolio',
          name: data.name.trim(),
          email: data.email.trim(),
          phone: phone || '—',
          message: data.message.trim(),
        }),
      });
      clearTimeout(timer);
      const out = await res.json().catch(() => ({}));
      if (!res.ok || out.success !== true) {
        console.error('Contact form error:', res.status, out.message);
        throw new Error(out.message || 'send failed');
      }
      form.reset();
      setStatus("✓ Sent! I'll get back to you within 24 hours.", 'ok');
    } catch {
      setStatus('Could not send right now — please message me on WhatsApp instead.', 'err');
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .lede { color: var(--muted); font-size: 18.5px; max-width: 50ch; }

  .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  @media (max-width: 680px) { .cards { grid-template-columns: 1fr; } }

  .services { background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 900px) { .svc-grid { grid-template-columns: 1fr; } }
  .svc { padding: 30px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); display: flex; flex-direction: column; gap: 14px; }
  .svc-icon { width: 40px; height: 40px; border-radius: 10px; border: 1.5px solid var(--k); background: color-mix(in srgb, var(--k) 16%, transparent); position: relative; }
  .svc-icon::after { content: ''; position: absolute; inset: 12px; border-radius: 3px; background: var(--k); }
  .svc h3 { font-size: 22px; }
  .svc p { color: var(--muted); font-size: 15.5px; }
  .svc ul { list-style: none; padding: 16px 0 0; margin: auto 0 0; border-top: 1px dashed var(--line-2); font-size: 13px; color: var(--muted); display: grid; gap: 6px; }
  .svc li::before { content: '→ '; color: var(--k); }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; counter-reset: s; }
  .steps li { padding: 28px 24px 0 0; border-top: 1px solid var(--line-2); position: relative; }
  .steps li::before { content: ''; position: absolute; top: -5px; left: 0; width: 9px; height: 9px; border-radius: 2px; background: var(--accent); }
  .steps .n { color: var(--accent); font-size: 13px; }
  .steps h3 { font-size: 20px; margin: 10px 0 8px; }
  .steps p { color: var(--muted); font-size: 15px; }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr 1fr; row-gap: 36px; } }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }

  .contact-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
  @media (max-width: 860px) { .contact-inner { grid-template-columns: 1fr; } }
  .contact h2 { font-size: clamp(32px, 4.4vw, 50px); margin: 14px 0 18px; }
  .direct { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .direct .wa { background: #25d366; border-color: #25d366; color: #06170c; }
  .direct .wa:hover { background: #3be07a; border-color: #3be07a; }
  .direct .wa .mono { font-size: 13.5px; }
  @media (max-width: 520px) { .direct .btn { width: 100%; justify-content: center; } }
  .note { margin-top: 28px; font-size: 12.5px; color: var(--faint); padding: 12px 14px; border: 1px dashed var(--line-2); border-radius: 10px; max-width: 48ch; }
  .form { display: grid; gap: 16px; padding: 28px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .form label { display: grid; gap: 7px; font-size: 14px; color: var(--muted); }
  .form input, .form textarea { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--line-2); border-radius: 9px; padding: 12px 14px; resize: vertical; }
  .form input:focus, .form textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent); }
  .form input::placeholder { color: var(--faint); }
  .form input:-webkit-autofill, .form input:-webkit-autofill:hover, .form input:-webkit-autofill:focus, .form textarea:-webkit-autofill {
    -webkit-text-fill-color: var(--text); caret-color: var(--text);
    -webkit-box-shadow: 0 0 0 1000px var(--bg) inset; box-shadow: 0 0 0 1000px var(--bg) inset;
    transition: background-color 9999s ease-out;
  }
  .form .opt { color: var(--faint); font-size: 12.5px; }
  .form .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .form button { justify-content: center; }
  .form button:disabled { opacity: .6; cursor: wait; transform: none; }
  .form-status { font-size: 13px; color: var(--muted); min-height: 1em; }
  .form-status[data-kind="ok"] { color: var(--k-action); }
  .form-status[data-kind="err"] { color: #f87171; }
  @media (max-width: 520px) { .form { padding: 20px; } .form input, .form textarea { font-size: 16px; } }
</style>
